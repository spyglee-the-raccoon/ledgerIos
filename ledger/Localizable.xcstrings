    "import_summary %lld %lld %lld %lld" : {
      "comment" : "A message summarizing the results of a CSV import operation. The first argument is the number of records successfully imported. The second argument is the number of sources created during the import. The third argument is the number of categories created during the import. The fourth argument is the number of records skipped during the import.",
