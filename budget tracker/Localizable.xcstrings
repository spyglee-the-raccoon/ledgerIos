        },
        "hr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "„%@“ nije prepoznata datoteka prihoda, troškova ili prijenosa. Provjerite odgovara li redak zaglavlja formatu izvoza."
