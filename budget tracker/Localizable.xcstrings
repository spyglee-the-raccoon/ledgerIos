        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "«%@» не є розпізнаним файлом доходів, витрат або переказів. Перевірте, чи рядок заголовків відповідає формату експорту."
          }
        }
      }
    },
